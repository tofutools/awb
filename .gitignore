/ignored/

# Build output
/awb

# Compiled frontend (tsc output; third-party bundles are committed)
/web/static/**/*.js
!/web/static/third_party/**

# Generated from openapi.yaml by build.sh — never committed, never edited
/internal/api/*_gen.go
/web/ts/api-types.ts

# What ogen leaves behind when it cannot format what it generated. It writes
# these beside its working directory rather than into --target, so the rule
# above does not cover them.
/internal/*_gen.go.dump

# Throwaway install tree for web/ts/third_party/rebuild.sh; never part of a build
/web/ts/third_party/node_modules/
