// ListReadyParams is parameters of listReady operation.
type ListReadyParams struct {
// Select these types. Repeat for several; values are ORed.
	Type []Type `json:",omitempty"`
// Select these priorities exactly. Repeat for several.
	Priority []Priority `json:",omitempty"`
// Inclusive, and reading as urgency rather than as a number: because 0 is
// the highest priority, `priority-max=1` means P0 and P1.
	PriorityMax OptPriority `json:",omitempty,omitzero"`
// Select these labels. Repeat for several; values are ORed.
	Label []Label `json:",omitempty"`
// Select these workspaces. Repeat for several; values are ORed. A key
// naming no workspace is a 404 rather than a listing that matches nothing.
	Workspace []WorkspaceKey `json:",omitempty"`
// Select the direct children of that issue — the issues whose `has-parent`
// relation names it — not the whole subtree.
	Parent OptString `json:",omitempty,omitzero"`
// Case-insensitive substring filter over the values displayed by this
// listing. Whitespace-separated words must all match, and filtering is
// applied before counting, sorting and pagination.
	Filter OptString `json:",omitempty,omitzero"`
// Ordering, optionally prefixed with `-` for descending. Every sort ends
// with `id` ascending as a final tiebreak, so the order is total.
// `status` and `type` order by the vocabulary rather than by the stored
// text: `status` runs open, in_progress, closed, and `type` runs epic,
// feature, bug, task, chore. `-` reverses those sequences.
	Sort OptSort `json:",omitempty,omitzero"`
// Cap the rows returned. There is no default: omitting it returns every
// row, so a listing is never silently truncated. Zero returns no rows
// while preserving the unpaged total in `X-Total-Count`.
	Limit OptInt `json:",omitempty,omitzero"`
// Skip this many rows.
	Offset OptInt `json:",omitempty,omitzero"`
}
